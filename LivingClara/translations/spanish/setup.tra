@25 /*SELECT_COMMON5*/ = ~Lista y esperando.~ [YF_Cla14]
@26 /*SELECT_COMMON6*/ = ~¿Hmm?~ [YF_Cla15]
@27 /*SELECT_ACTION1*/ = ~Voy.~ [YF_Cla16]
@28 /*SELECT_ACTION2*/ = ~Claro.~ [YF_Cla17]
@29 /*SELECT_ACTION3*/ = ~Está hecho.~ [YF_Cla18]
@30 /*SELECT_ACTION4*/ = ~Yo me encargo.~ [YF_Cla19]
@31 /*SELECT_ACTION5*/ = ~Ya desapareció.~ [YF_Cla20]
@32 /*SELECT_ACTION6*/ = ~A tus órdenes.~ [YF_Cla21]
