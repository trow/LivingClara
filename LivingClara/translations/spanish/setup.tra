@34 /*SELECT_RARE1*/ = ~Cuidado.~ [YF_Cla23]
@35 /*SELECT_RARE2*/ = ~Repítelo y te lo quito.~ [YF_Cla24]
@36 /*CRITICAL_HIT*/ = ~Hah, lo tengo.~ [YF_Cla25]
