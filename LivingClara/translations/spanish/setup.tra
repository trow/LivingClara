@39 /*INVENTORY_FULL*/ = ~Eso es imposible.~ [YF_Cla28]
@40 /*HAPPY*/ = ~*Silbido alegre*~ [YF_Cla29]
@41 /*UNHAPPY_ANNOYED*/ = ~No quiero hacer esto.~
@42 /*UNHAPPY_SERIOUS*/ = ~Ugh. Preferiría seguir trabajando para los Ladrones de la Sombra.~
@43 /*SET_A_TRAP*/ = ~Así es como se hace.~ [YF_Cla30]
@44 /*HIDDEN_IN_SHADOWS*/ = ~Como una sombra.~ [YF_Cla31]
