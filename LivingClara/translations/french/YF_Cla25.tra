//Dialogue d'Invocation de l'Esprit du Destin pour Clara
@0 /*Charname*/ = ~Amène-moi Clara, la danseuse d'ombre.~

//si vous l'avez sauvée auparavant
@1 /*Clara*/ = ~Hé, <CHARNAME>, c'est toi qui as invoqué la noble Caroline Louisa Audrey Rosanna Alexandra...~
@2 /*Player*/ = ~Bon, Clara, c'est mon plan poche, et tout le monde ici est ami. Je t'ai appelée parce que je veux que tu te joignes à mon groupe.~
@3 /*Player*/ = ~Ça suffit – tout ce que tu dois savoir, c'est que tu dois réintégrer l'équipe.~
@4 /*Player*/ = ~J'ai besoin de ta force pour mon voyage, Caroline. Aide-moi, s'il te plaît.~
@5 /*Player*/ = ~Désolé, Clara. J'ai changé d'avis. Attends ici pour l'instant.~
@6 /*Clara*/ = ~D'accord, <CHARNAME>, puisque tu m'as appelée, qu'est-ce que je peux faire d'autre ? Allons-y.~
@7 /*Clara*/ = ~Directe et précise comme toujours, <CHARNAME>. Mais c'est pour ça que je t'aime bien. Allons-y !~
@8 /*Clara*/ = ~Oh, <CHARNAME>, je suis ravie de t'être utile. Continuons notre route.~
@9 /*Clara*/ = ~Tu vas juste me laisser ici ? Ce n'est pas très gentil.~
@10 /*Clara*/ = ~D'accord, j'attendrai. Je n'ai pas l'air d'avoir beaucoup d'autre choix.~

//si vous ne l'avez pas sauvée auparavant
@11 /*Clara*/ = ~Quoi ? Où suis-je ? Qui es-tu ? Tu as l'air familier mais je ne me souviens plus vraiment... tout cela ressemble à un mauvais rêve.~
@12 /*Player*/ = ~Félicitations, tu es dans le groupe. J'espère que tu as des compétences utiles.~
@13 /*Player*/ = ~Nous avons voyagé ensemble brièvement et j'ai de nouveau besoin de ton aide.~
@14 /*Player*/ = ~Je ne sais pas à quoi je pensais. Je vais invoquer quelqu'un d'autre.~
@15 /*Clara*/ = ~Je veux dire, je suppose que oui. Je suis si confuse.~
@17 /*Clara*/ = ~C'était <CHARNAME>, n'est-ce pas ? Je crois que je me souviens. Peut-être peux-tu m'en dire plus.~
@18 /*Clara*/ = ~Tu vas juste me laisser ici ? Ce n'est pas très gentil.~

//Quand elle attend et ne vous a pas rejoint auparavant
@20 /*Clara*/ = ~Oh, <CHARNAME>. Tu es de retour. Je peux voyager avec toi maintenant ?~
@21 /*Player*/ = ~Oui, Clara. Viens avec moi.~
@22 /*Player*/ = ~Désolé(e). Je n'ai pas encore besoin de toi.~
@23 /*Clara*/ = ~Tu es sérieux/sérieuse ? Oh, dieu merci. Sortons d'ici.~
@24 /*Clara*/ = ~Sérieusement ? D'accord alors. Laisse-moi juste ici à mourir de faim.~